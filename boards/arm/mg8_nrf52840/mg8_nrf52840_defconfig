CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_MG8_NRF52840=y

CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# USB carries power only, so logs go over SEGGER RTT through the J-Link
CONFIG_USE_SEGGER_RTT=y
CONFIG_SERIAL=n
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=n
CONFIG_RTT_CONSOLE=y

CONFIG_GPIO=y

# 32.768 kHz crystal on P0.00/P0.01 (confirmed: LFCLKSTAT source = Xtal, RTC1 counts 32768/s)
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
